# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# I file che scrive l'applicazione: l'archivio delle figurine (M7).
# ⚠ Sta fuori da `public/` di proposito — vedi lib/campioncini.ts — e fuori da
# git perché sono 51 MB di immagini che si riscaricano in sette secondi.
/storage

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — mai committare i segreti; l'esempio sì
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts
