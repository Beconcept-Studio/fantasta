# Copia questo file in `.env` e riempi i valori. Vedi docs/RUNBOOK.md.

# Postgres locale servito da docker-compose.yml
DATABASE_URL="postgres://postgres:dev@localhost:5433/asta"

# Segreto di firma delle sessioni Auth.js. Generalo con: openssl rand -base64 32
AUTH_SECRET=""

# In produzione: l'URL pubblico dell'app (es. https://asta.tuodominio.it).
# In locale può restare vuoto: Auth.js usa http://localhost:3000.
AUTH_URL=""

# Google Cloud Console → Credenziali → OAuth Client ID (Applicazione web).
# Redirect URI autorizzato in locale: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── SMTP, per i codici di verifica e di recupero password (M5) ───────────────
#
# ⚠ In locale queste quattro righe si lasciano vuote: fuori produzione il codice
# NON viene spedito, viene stampato sullo stdout del dev server. L'intero flusso
# di registrazione si collauda senza avere nessuna credenziale SMTP.
#
# In produzione servono tutte: sono le credenziali SMTP di MailerSend (dominio
# verificato → SMTP users). Dopo averle cambiate serve
# `pm2 reload deploy/ecosystem.config.cjs --update-env`, non `pm2 restart asta`.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Il mittente, che deve stare sul dominio verificato presso il provider.
MAIL_FROM="Asta Fantacalcio <asta@example.com>"
