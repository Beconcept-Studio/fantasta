# Copia questo file in `.env` e riempi i valori. Vedi docs/RUNBOOK.md.

# Postgres locale servito da docker-compose.yml
DATABASE_URL="postgres://postgres:dev@localhost:5433/asta"

# Segreto di firma delle sessioni Auth.js. Generalo con: openssl rand -base64 32
AUTH_SECRET=""

# In produzione: l'URL pubblico dell'app (es. https://asta.tuodominio.it).
# In locale può restare vuoto: Auth.js usa http://localhost:3000.
AUTH_URL=""

# Google Cloud Console → Credenziali → OAuth Client ID (Applicazione web).
# Redirect URI autorizzato in locale: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── SMTP, per i codici di verifica e di recupero password (M5) ───────────────
#
# ⚠ In locale si possono lasciare vuote: **senza `SMTP_HOST` il codice non viene
# spedito, viene stampato sullo stdout del dev server**. L'intero flusso di
# registrazione si collauda così, senza avere nessuna credenziale.
#
# ⚠ Ma se `SMTP_HOST` c'è, **in locale le email partono davvero** — è il modo di
# verificare le credenziali prima del deploy invece che la sera dell'asta. Il
# rovescio: un `.env` di produzione copiato qui manda email vere a indirizzi di
# prova, a spese della quota del provider. Per tornare allo stdout basta
# svuotare `SMTP_HOST`. Sotto `pnpm test` non si manda mai, in nessun caso.
#
# In produzione servono tutte: sono le credenziali SMTP di MailerSend (dominio
# verificato → SMTP users). Dopo averle cambiate serve
# `pm2 reload deploy/ecosystem.config.cjs --update-env`, non `pm2 restart asta`.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Il mittente, che deve stare sul dominio verificato presso il provider.
MAIL_FROM="Asta Fantacalcio <asta@example.com>"

# ─── Le figurine dei calciatori (M7) ──────────────────────────────────────────
#
# ⚠ **L'unica parte dell'URL delle figurine che invecchia**: è la stagione. Oggi
# è la `21`; la `20` risponde ancora, la `22` no. Ad agosto prossimo va cambiata
# qui e poi, sul server, va dato
# `pm2 reload deploy/ecosystem.config.cjs --update-env` — non `pm2 restart asta`.
#
# Si può lasciare vuota: il codice ha `21` come default, così una variabile
# assente non rompe niente. Una variabile *sbagliata* invece si vede subito,
# perché non si scarica più nessuna figurina.
CAMPIONCINI_EDITION="21"

# La cartella dove l'applicazione scrive i file che deve conservare (l'archivio
# delle figurine). **Non serve metterla**: in produzione la calcola
# `deploy/ecosystem.config.cjs` dalla radice del progetto, e in sviluppo il
# default è `<radice>/storage`.
# MEDIA_DIR=""
